#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @RAITEI_VERSION_MAJOR@,@RAITEI_VERSION_MINOR@,@RAITEI_VERSION_PATCH@,0
PRODUCTVERSION @RAITEI_VERSION_MAJOR@,@RAITEI_VERSION_MINOR@,@RAITEI_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Raitei"
            VALUE "FileVersion", "@RAITEI_VERSION@"
            VALUE "InternalName", "raitei"
            VALUE "OriginalFilename", "raitei.dll"
            VALUE "ProductName", "Raitei"
            VALUE "ProductVersion", "@RAITEI_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
